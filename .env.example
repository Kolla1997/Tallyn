# Copy to .env and fill in real values. Never commit .env.
# All values below are fake placeholders.

# Server
PORT=8080
WEB_DIR=web/dist

# Supabase (backend only: the React app never sees these) — #6, #7
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me
DATABASE_URL=postgres://postgres:replace-me@db.your-project.supabase.co:5432/postgres

# Plaid (use sandbox while developing) — #8, #9
PLAID_CLIENT_ID=replace-me
PLAID_SECRET=replace-me
PLAID_ENV=sandbox

# 32-byte key, base64. Encrypts Plaid access tokens before storage — #8
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-me
