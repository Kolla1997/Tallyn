# Copy to .env and fill in real values. Never commit .env.
# All values below are fake placeholders.

# Server
PORT=8080
WEB_DIR=web/dist

# Supabase (backend only: the React app never sees these) — #6, #7, #30
# Without SUPABASE_URL or DATABASE_URL the server still starts, but /api/ routes answer 503.
# Access tokens are checked against the project's public signing keys
# (<SUPABASE_URL>/auth/v1/.well-known/jwks.json), so no JWT secret is needed (ADR 0003).
# The web app's own (public) Supabase values go in web/.env.local: see web/.env.example.
SUPABASE_URL=https://your-project.supabase.co
# Database logins (ADR 0006). Copy the pooler host from Supabase → Connect → Session pooler.
# Usernames are role.projectref. Percent-encode special characters in passwords.
# The server refuses to start if DATABASE_URL or DATABASE_URL_SYNC is a login
# that can bypass row-level security (e.g. postgres).
DATABASE_URL=postgresql://tallyn_api.your-project-ref:API_PASSWORD@your-pooler-host:5432/postgres
DATABASE_URL_SYNC=postgresql://tallyn_sync.your-project-ref:SYNC_PASSWORD@your-pooler-host:5432/postgres
# Only for running migrations by hand (psql). The app never reads it. Never set it on the production host.
ADMIN_DATABASE_URL=postgresql://postgres.your-project-ref:ADMIN_PASSWORD@your-pooler-host:5432/postgres
# Not used yet. Never used for database access (ADR 0002), never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Plaid (use sandbox while developing) — #8, #9
PLAID_CLIENT_ID=replace-me
PLAID_SECRET=replace-me
PLAID_ENV=sandbox
# Only for banks that use OAuth (many big US banks, in production). Register it in the Plaid dashboard.
PLAID_REDIRECT_URI=

# 32-byte key, base64. Encrypts Plaid access tokens before storage — #8 (ADR 0004)
# Generate one with: openssl rand -base64 32
# Use a different key per environment. Losing it means every bank must be re-linked.
# Without it (or the Plaid keys) the server runs, but bank linking answers 503.
TOKEN_ENCRYPTION_KEY=replace-me

# How often the bank sync runs (#9). Default 6h; minimum 1m.
SYNC_EVERY=6h
