# Copy to web/.env.local and fill in. Never commit .env.local.
# Both values are public by design: they ship to every browser (ADR 0003).
# Never put the service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-me

# The map in the transaction details (#60): our US map file and its label fonts, both on
# our R2 host (public). Leave VITE_MAP_URL empty for no map.
VITE_MAP_URL=https://pub-xxxxxxxx.r2.dev/us.pmtiles
VITE_MAP_ASSETS=https://pub-xxxxxxxx.r2.dev/map-assets
